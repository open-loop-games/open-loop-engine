{
  "name": "@open-loop/engine",
  "version": "0.7.3",
  "description": "Headless TypeScript substrate for incremental and idle games. Reactive state, big-number math, composable evaluation kernel, registration surfaces for skills/producers/purchasables/achievements/challenges/dialog/zones.",
  "license": "MIT",
  "author": "namahanna <namahanna@gmail.com>",
  "homepage": "https://codeberg.org/namahanna/open-loop-engine",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/namahanna/open-loop-engine.git"
  },
  "bugs": {
    "url": "https://codeberg.org/namahanna/open-loop-engine/issues"
  },
  "keywords": [
    "incremental",
    "idle",
    "idle-game",
    "incremental-game",
    "game-engine",
    "headless",
    "vue",
    "reactivity",
    "break_eternity"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "./dist/primitives/decimal.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./primitives": "./dist/primitives/index.js",
    "./core": "./dist/core/index.js",
    "./systems": "./dist/systems/index.js",
    "./harness": "./dist/harness/index.js",
    "./types": "./dist/primitives/types.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "ol-domain-map": "scripts/build-domain-map.mjs"
  },
  "files": [
    "dist",
    "src",
    "docs/*.md",
    "docs/api",
    "AGENTS.md",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md",
    ".claude/CLAUDE.md",
    "scripts/build-domain-map.mjs",
    "scripts/lib/domain-extract.mjs",
    "scripts/lib/domain-render.mjs"
  ],
  "scripts": {
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "build": "tsc && tsc-alias --resolve-full-paths && pnpm build:api",
    "build:api": "node scripts/build-api-docs.mjs",
    "release": "node scripts/release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "check:nodenext": "tsc -p scripts/nodenext-check/tsconfig.json && tsc -p scripts/nodenext-check/tsconfig.bundler.json",
    "lint": "oxlint src/",
    "format": "oxfmt src tests scripts",
    "format:check": "oxfmt --check src tests scripts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mjs,js,json}": "oxfmt --no-error-on-unmatched-pattern",
    "src/**/*.ts": "oxlint --fix"
  },
  "peerDependencies": {
    "break_eternity.js": "^2.1.0",
    "eternal_notations": "^1.1.1",
    "ts-morph": ">=26",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "ts-morph": {
      "optional": true
    }
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "nanoevents": "^9.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "break_eternity.js": "^2.1.3",
    "eternal_notations": "^1.1.1",
    "git-cliff": "^2.14.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "ts-morph": "^28.0.0",
    "tsc-alias": "^1.8.17",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1",
    "vue": "^3.5.43"
  }
}
